# 本機開發：docker-compose up 後預設連線字串如下
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kid_exhibition?schema=public"

# 時區（全系統一律使用 Asia/Taipei，見 PROJECT_SPEC.md 第 1 節）
TZ="Asia/Taipei"

# Cloudflare Turnstile（正式環境必填；本機開發若留空則後端會跳過驗證並印出警告）
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# 發信服務（尚未整合，先保留欄位；見 PROJECT_SPEC.md 第 3.4 節，需用 Resend/SES 等，不可用主機內建 mail()）
RESEND_API_KEY=""
MAIL_FROM="noreply@example.com"

# 後台帳號（雛形先用簡易環境變數登入，正式上線前需改為資料庫帳號＋雜湊密碼）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme"
